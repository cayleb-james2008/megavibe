{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Megavibe",
  "version": "0.1.0",
  "identifier": "so.megavibe.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "bash src-tauri/scripts/stage-llama-libs.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Megavibe",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#111214"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; frame-src http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "resources": {
      "licenses/flite-rs/LICENSE": "licenses/flite-rs/LICENSE",
      "licenses/flite-rs/NOTICE": "licenses/flite-rs/NOTICE",
      "licenses/flite-rs/THIRD-PARTY-LICENSES.md": "licenses/flite-rs/THIRD-PARTY-LICENSES.md",
      "licenses/llama.cpp/LICENSE": "licenses/llama.cpp/LICENSE",
      "licenses/whisper.cpp/LICENSE": "licenses/whisper.cpp/LICENSE",
      "resources/voice-libs/": "voice-libs/"
    },
    "category": "Development",
    "shortDescription": "A local-first workspace for coding terminals",
    "longDescription": "Megavibe is a local-first Linux desktop workspace for coding terminals, project boards, teams, memory and Git workflows.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libasound2"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
